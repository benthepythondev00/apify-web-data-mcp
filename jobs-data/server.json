{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.benthepythondev00/jobs-data",
  "title": "Jobs Data",
  "description": "Remote job boards, LinkedIn jobs, company ATS pages and Upwork jobs as tools. Runs on Apify.",
  "repository": {
    "url": "https://github.com/benthepythondev00/apify-web-data-mcp",
    "source": "github"
  },
  "websiteUrl": "https://github.com/benthepythondev00/apify-web-data-mcp#jobs-data",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/benthepythondev00/apify-web-data-mcp/main/jobs-data/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "version": "1.0.1",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.apify.com/?tools=benthepythondev/remote-jobs-aggregator,benthepythondev/linkedin-jobs-scraper,benthepythondev/ats-jobs-aggregator,benthepythondev/upwork-jobs-scraper",
      "headers": [
        {
          "name": "Authorization",
          "description": "Apify API token, for example 'Bearer <apify-api-token>'",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
