{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.benthepythondev00/real-estate-data",
  "title": "Real Estate Data",
  "description": "Zillow homes and rentals, Zumper rentals and Craigslist housing listings as tools. Runs on Apify.",
  "repository": {
    "url": "https://github.com/benthepythondev00/apify-web-data-mcp",
    "source": "github"
  },
  "websiteUrl": "https://github.com/benthepythondev00/apify-web-data-mcp#real-estate-data",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/benthepythondev00/apify-web-data-mcp/main/real-estate-data/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "version": "1.0.1",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.apify.com/?tools=benthepythondev/zillow-scraper,benthepythondev/zillow-detail-scraper,benthepythondev/zillow-rentals-scraper,benthepythondev/zumper-rental-scraper,benthepythondev/craigslist-real-estate-scraper",
      "headers": [
        {
          "name": "Authorization",
          "description": "Apify API token, for example 'Bearer <apify-api-token>'",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
